msgid "You want to overwrite the left picture with the one on the right."
msgstr "Jy wil die prent aan die linkerkant met die een aan die regterkant oorskryf."

#: imagevisualizer.cpp:46
msgid ""
"This picture isn't stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Hierdie prent is nie op die plaaslike\n"
"masjien gestoor nie.\n"
"Kliek op hierdie skakel om dit te laai.\n"

