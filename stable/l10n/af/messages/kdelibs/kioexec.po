#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Maak afgeleë leers oop, hou hulle dop vir veranderinge en vra "
"toestemming vir oplaai"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Behandel URLs as plaaslike lêers en vee hulle na die tyd uit"

#: main.cpp:55
msgid "Command to execute"
msgstr "Opdrag om uit te voer"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(s) of plaaslike lêer(s) gebruik as 'opdrag'"

#: main.cpp:72
msgid ""
"'command' expected.\n"
msgstr ""
"'opdrag' verwag.\n"

#: main.cpp:97
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Die URL %1\n"
"het 'n formatering fout"

#: main.cpp:99
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr "'--tempfiles' opsie word nie aanvaar met afgeleë URL %1 nie"

#: main.cpp:226
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Die tydelike lêer\n"
"%1\n"
"het verander.\n"
"Wil jy dit nogsteeds uitvee?"

#: main.cpp:227 main.cpp:234
msgid "File Changed"
msgstr "Lêer het Verander"

#: main.cpp:233
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Die lêer\n"
"%1\n"
"het verander.\n"
"Wil jy die veranderinge oplaai?"

