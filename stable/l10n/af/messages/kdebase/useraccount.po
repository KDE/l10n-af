msgid "You must enter your password in order to change your information."
msgstr "Jy moet jou wagwoord insleutel om die veranderde gegewens te stoor."

#: main.cpp:227
msgid "You must enter a correct password."
msgstr "Jy moet 'n korrekte wagwoord insleutel."

