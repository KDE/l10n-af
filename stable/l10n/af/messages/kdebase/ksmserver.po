#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Frikkie Thirion, Juanita Franz"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "frix@expertron.co.za, juanita.franz@vr-web.de"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Die betroubare Kde sessie bestuurder wat in die standaard X11R6 \n"
"sessie bestuuring protokol (XSMP) praat."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Herstel die gestoorde gebruiker sessie indien beskikbaar"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Begin 'wm' in geval geen ander venster bestuurder \n"
"deelneem in die sessie. Verstek is 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections"
msgstr "Laat ook afgeleë koppelinge toe."

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "Die KDE Sessie Bestuurder"

#: main.cpp:186
msgid "Maintainer"
msgstr "Onderhouer"

#: shutdown.cpp:91
msgid "End Session for \"%1\""
msgstr "Beëindig Sessie vir \"%1\""

#: shutdown.cpp:117
msgid "&End Current Session"
msgstr "Beëindig Huidige Sessie"

#: shutdown.cpp:125
msgid "&Turn Off Computer"
msgstr "Skakel rekenaar af"

#: shutdown.cpp:133
msgid "&Restart Computer"
msgstr "Herbegin rekenaar"

#: shutdown.cpp:151
msgid ""
"_: current option in boot loader\n"
" (current)"
msgstr " (huidige)"
