#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes from "
"other platforms in your new KDE desktop. The most common type of legacy theme "
"is for the GTK toolkit, which is imported to KDE's Control Center with this "
"utility.<P>In order to do this you must specify at least one item: the folder "
"where the pixmaps for the theme is located. You may also have to specify the "
"theme's gtkrc file if it's not in the same folder as the pixmaps. Both are "
"usually in the folder \"gtk\" inside the theme's folder.</QT>"
msgstr ""
"<QT><b>Oorgeërfde Tema Importeerder</b><P>KDE nou ondersteun nuttige temas van "
"ander platforms in jou nuwe KDE werkskerm. Die mees algemene tipe van argïese tema "
"is vir die GTK gereedskapskas, wat ingevoer word na KDE se Kontrole Sentrum met hierdie "
"nutting.<P>Om dit te doen moet jy ten minste een item spesifiseer: die gids "
"waar die pix-kaarte vir hierdie tema gelokaliseer is. Jy sal dalk ook moet spesifiseer die "
"thema se gtkrc lêer as dit nie dieselfde gids is as die pix-kaarte. Beide is gewoonlik "
"in die gids \"gtk\" binne die tema se gids.</QT>"

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Step 1: Spesifiseer tema se bispatroon kabinet:"

#: legacyimport.cpp:51
msgid "Specify pixmap Folder"
msgstr "Spesifiseer pixkaart gids"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the specified "
"folder. If it exists somewhere other than where the pixmaps are located enter "
"it here.</QT>"
msgstr ""
"<QT><b>Oorgeërfde Tema Invoerder</b><P>'n gtkrc lêer was nie gevind in die "
"gespesifiseer gids. As dit êrens anders bestaan is as waar die pix-kaarte geleë is "
"voer dit hier in.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Step 2: Spesifiseer tema se gtkrc:"

#: legacyimport.cpp:76
msgid "Specify gtkrc Folder"
msgstr "Spesifiseer gtkrc Gids"

#: legacyimport.cpp:85
msgid "Legacy Import"
msgstr "Oorgeërfde In voer"

#: legacyimport.cpp:92
msgid "GTK Themes Folder"
msgstr "Gtk Temas Kabinet"

#: legacyimport.cpp:116 legacyimport.cpp:137
msgid "You did not enter a valid file!"
msgstr "Jy het nie ingevoer 'n geldige lêer!"

#: legacyimport.cpp:124
msgid "Gtkrc Theme File"
msgstr "Gtkrc Tema Lêer"

#: legacyimport.cpp:143
msgid "Theme Title"
msgstr "Tema Titel"

#: legacyimport.cpp:144
msgid "Please enter a short title for this theme:"
msgstr "Asseblief invoer 'n kort titel vir hierdie tema:"

#: legacyimport.cpp:151
msgid "Legacy widget theme"
msgstr "Oorgeërfde gui-element tema"

#: legacyimport.cpp:157
msgid "The theme is now installed and will be shown in KDE's Control Center."
msgstr "Die tema is nou installeerd en sal vertoon word in die KDE se Kontrole Sentrum."

#: legacyimport.cpp:164
msgid "KLegacyImport"
msgstr "Klegacyimport"

#: legacyimport.cpp:165
msgid "Importer for legacy themes"
msgstr "Invoerder vir oorgeërfde temas"

