msgstr "Java Looptyd Instellings"

#: javaopts.cpp:110
msgid "&Use security manager"
msgstr "Gebruik sekuriteit bestuurder"

#: javaopts.cpp:114
msgid "Use &KIO"
msgstr "Gebruik &KIO"

#: javaopts.cpp:118
msgid "Shu&tdown applet server when inactive"
msgstr "Afskakel miniprogram bediener wanneer onaktiewe"

#: javaopts.cpp:128
