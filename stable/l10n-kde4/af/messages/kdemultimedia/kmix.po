#: mixer_alsa9.cpp:809
msgid ""
"You do not have permission to access the alsa mixer device.\n"
"Please verify if all alsa devices are properly created."
msgstr ""
"Jy het nie toegangs regte na die alsa menger toestel toe nie.\n"
"Maak asb seker dat die alsa toestel korrek geskep is."

#: mixer_alsa9.cpp:813
msgid ""
"Alsa mixer cannot be found.\n"
"Please check that the soundcard is installed and the\n"
"soundcard driver is loaded.\n"
msgstr ""
"Alsa menger word nie gevind nie.\n"
"Maak asseblief seker dat die klankaart geinstalleer is \n"
"en die klankkaart drywers gelaai is.\n"

#: mixer_backend.cpp:183
msgid ""
"kmix:You do not have permission to access the mixer device.\n"
"Please check your operating systems manual to allow the access."
msgstr ""
"kmix:Jy het nie toestemming om die menger toestel te gebruik nie.\n"
"Kyk in die stelsel handboek hoe om toegang toe te laat."

#: mixer_backend.cpp:187
msgid "kmix: Could not write to mixer."
msgstr "kmix: Kon nie skryf na menger."

#: mixer_backend.cpp:190
msgid "kmix: Could not read from mixer."
msgstr "kmix: Kon nie lees van menger."

#: mixer_backend.cpp:193
msgid ""
"kmix: Mixer cannot be found.\n"
"Please check that the soundcard is installed and that\n"
"the soundcard driver is loaded.\n"
msgstr ""
"kmix: Menger is nie gevind nie.\n"
"Asseblief bevestig dat die klankkaart geïnstalleer is en dat\n"
"die klankkaart drywer gelaai is.\n"

#: mixer_backend.cpp:198
msgid "kmix: Unknown error. Please report how you produced this error."
msgstr ""
"kmix: Onbekende fout. Asseblief rapporteer hoe jy hierdie fout geproduseer "
"het."

