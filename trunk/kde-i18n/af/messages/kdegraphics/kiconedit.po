#: main.cpp:39
msgid "KDE Icon Editor"
msgstr "kde ikoon redigeerder"

#: main.cpp:43
msgid "Icon file(s) to open"
msgstr "ikoon lêer(s) aan open"

#: main.cpp:96
msgid "KIconEdit"
msgstr "k-ikoon-redigeer"

#: kiconedit.cpp:166 kiconeditslots.cpp:94 kiconeditslots.cpp:144
#: kiconeditslots.cpp:323
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"die huidige lêer het al veranderde.\n"
"doen jy wil hê aan stoor dit?"

#: kiconedit.cpp:271
msgid "New &Window"
msgstr "nuwe venster"

#: kiconedit.cpp:273
msgid ""
"New window\n"
"\n"
"Opens a new Icon Editor window."
msgstr ""
"nuwe venster\n"
"\n"
"maak oop 'n nuwe ikoon redigeerder venster."

#: kiconedit.cpp:281
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"nuwe\n"
"\n"
"skep 'n nuwe ikoon, òf van 'n werkvoorbeeld of deur spesifisering die "
"grootte"

#: kiconedit.cpp:287
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"open\n"
"\n"
"open 'n bestaande ikoon"

#: kiconedit.cpp:301
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"stoor\n"
"\n"
"stoor die huidige ikoon"

#: kiconedit.cpp:312
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""

#: kiconedit.cpp:326
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"knip\n"
"\n"
"knip die huidige keuse uit van die ikoon\n"
"\n"
"(leidraad: jy kan maak beide vierkantige en sirkelvormige kiesings)"

#: kiconedit.cpp:333
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"kopie\n"
"\n"
"kopie die huidige keuse uit van die ikoon\n"
"\n"
"(leidraad: jy kan maak beide vierkantige en sirkelvormige kiesings)"

#: kiconedit.cpp:340
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""
"plak\n"
"\n"
"plak die inhoud van die klipbord binnein die huidige ikoon.\n"
"\n"
"as die inhoud word grootter as die huidige ikoon jy kan plak hulle in 'n "
"nuwe venster.\n"
"\n"
"(leidraad: kies \"plak transparent beeld elemente\" in die opstelling "
"dialoog as jy asook wil hê aan plak deursigtigheid.)"

#: kiconedit.cpp:349
msgid "Paste as &New"
msgstr "plak as nuwe"

#: kiconedit.cpp:352
msgid "Clea&r"
msgstr "maak skoon"

#: kiconedit.cpp:356
#, fuzzy
msgid "Rectangular Selection"
msgstr "driehoek"

#: kiconedit.cpp:358
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""

#: kiconedit.cpp:363
msgid "Circular Selection"
msgstr ""

#: kiconedit.cpp:365
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""

#: kiconedit.cpp:375
msgid "&Resize"
msgstr "hervergroot"

#: kiconedit.cpp:377
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""
"hervergroot\n"
"\n"
"glad hervergroot die ikoon terwyl probeer aan behou die inhoud"

#: kiconedit.cpp:382
msgid "&GrayScale"
msgstr "gryskleur"

#: kiconedit.cpp:384
msgid ""
"Gray scale\n"
"\n"
"Gray scale the current icon.\n"
"(Warning: The result is likely to contain colors not in the icon palette"
msgstr ""
"grys skaal\n"
"\n"
"grys skaal die huidige ikoon.\n"
"(waarskuwing: die resultaat is waarskynlik aan bevat kleure nie in die ikoon "
"palet"

#: kiconedit.cpp:395
msgid "1:1"
msgstr "1:1"

#: kiconedit.cpp:396
msgid "1:5"
msgstr "1:5"

#: kiconedit.cpp:397
msgid "1:10"
msgstr "1:10"

#: kiconedit.cpp:403
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one."
msgstr ""

#: kiconedit.cpp:408
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""

#: kiconedit.cpp:412
msgid "Zoom Factor"
msgstr "zoem faktor"

#: kiconedit.cpp:423
msgid "Show &Grid"
msgstr "vertoon rooster"

#: kiconedit.cpp:429
msgid "Show &Drawing Tools"
msgstr "vertoon teken nutsprogramme"

#: kiconedit.cpp:436
msgid "&Save Options"
msgstr "stoor opsies"

#: kiconedit.cpp:468
msgid "Find pixel"
msgstr "soek pixel"

#: kiconedit.cpp:473
msgid ""
"Find\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"soek\n"
"\n"
"die kleur van die pixel gekliek het op sal wees die huidige teken kleur"

#: kiconedit.cpp:476
msgid "Freehand"
msgstr "vryhand"

#: kiconedit.cpp:481
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"vry hand\n"
"\n"
"teken non-linear lyne"

#: kiconedit.cpp:484
msgid "Rectangle"
msgstr "driehoek"

#: kiconedit.cpp:489
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"driehoek\n"
"\n"
"teken 'n driehoek"

#: kiconedit.cpp:492
msgid "Filled Rectangle"
msgstr "gevul driehoek"

#: kiconedit.cpp:497
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"gevul driehoek\n"
"\n"
"teken 'n gevul driehoek"

#: kiconedit.cpp:500
msgid "Circle"
msgstr "sirkel"

#: kiconedit.cpp:505
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"sirkel\n"
"\n"
"teken 'n sirkel"

#: kiconedit.cpp:508
msgid "Filled Circle"
msgstr "gevul sirkel"

#: kiconedit.cpp:513
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"gevul sirkel\n"
"\n"
"teken 'n gevul sirkel"

#: kiconedit.cpp:516
msgid "Ellipse"
msgstr "elipse"

#: kiconedit.cpp:521
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"elipse\n"
"\n"
"teken 'n elipse"

#: kiconedit.cpp:524
msgid "Filled Ellipse"
msgstr "gevul elipse"

#: kiconedit.cpp:529
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"gevul elipse\n"
"\n"
"teken 'n gevul elipse"

#: kiconedit.cpp:532
msgid "Spray"
msgstr "sproei"

#: kiconedit.cpp:537
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"sproei\n"
"\n"
"teken verstrooide beeld elemente in die huidige kleur"

#: kiconedit.cpp:540
msgid "Flood Fill"
msgstr "vloed opvul"

#: kiconedit.cpp:545
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"vloed opvul\n"
"\n"
"opvul aangrensende beeld elemente met die selfde kleur met die huidige kleur"

#: kiconedit.cpp:548
msgid "Line"
msgstr "lyn"

#: kiconedit.cpp:553
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"lyn\n"
"\n"
"teken 'n reguit lyn vertikaal, horisontaal of na 45 grade. hoeke"

#: kiconedit.cpp:556
msgid "Eraser (Transparent)"
msgstr "uitveer (transparent)"

#: kiconedit.cpp:561
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"vee uit\n"
"\n"
"vee uit beeld elemente. stel die beeld elemente aan wees transparent\n"
"\n"
"(leidraad: as jy wil hê aan teken deursigtigheid met 'n ander program, "
"eerste kliek op \"vee uit\" dan word op die program jy wil hê aan gebruik)"

#: kiconedit.cpp:589
msgid "Zoom out"
msgstr "zoem uit"

#: kiconedit.cpp:592
msgid "Zoom in"
msgstr "zoem in"

#: kiconedit.cpp:596
msgid "Toggle grid"
msgstr "wissel rooster"

#: kiconedit.cpp:603
msgid "What is ...?"
msgstr "wat is ...?"

#: kiconedit.cpp:619
msgid "System Colors"
msgstr "stelsel kleure"

#: kiconedit.cpp:645
msgid "Custom Colors"
msgstr "pasmaak kleure"

#: kiconedit.cpp:680
msgid ""
"Icon draw grid\n"
"\n"
"The icon grid is the area where you draw the icons.\n"
"You can zoom in and out using the magnifying glasses on the toolbar.\n"
"(Tip: Hold the magnify button down for a few seconds to zoom to a predefined "
"scale"
msgstr ""
"ikoon teken rooster\n"
"\n"
"die ikoon rooster is die area waar jy teken die ikoone.\n"
"jy kan zoem in en uit te gebruik die vergroot glaasse op die nutsbalk.\n"
"(leidraad: hou die vergroot knoppie ondertoe vir 'n paar sekondes aan zoem "
"aan 'n vooraf gedefinieerde skaal"

#: kiconedit.cpp:685
msgid ""
"Rulers\n"
"\n"
"This is a visual representation of the current cursor position"
msgstr ""
"lineale\n"
"\n"
"hierdie is 'n visuele voorstelling van die huidige plekaanduier posisie"

#: kiconedit.cpp:689
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors\n"
"\t- Application messages"
msgstr ""
"statusbalk\n"
"\n"
"die statusbalk gee informasie op die status van die huidige ikoon. die velde "
"word:\n"
"\n"
"\t- plekaanduier posisie\n"
"\t- grootte\n"
"\t- zoem faktor\n"
"\t- nommer van kleure\n"
"\t- aansoek boodskappe"

#: kiconedit.cpp:699
msgid ""
"Preview\n"
"\n"
"This is a 1:1 preview of the current icon"
msgstr ""
"voorskou\n"
"\n"
"hierdie is 'n 1:1 voorskou van die huidige ikoon"

#: kiconedit.cpp:702
msgid ""
"System colors\n"
"\n"
"Here you can select colors from the KDE Icon Palette."
msgstr ""
"stelsel kleure\n"
"\n"
"hier jy kan kies kleure van die kde ikoon palet."

#: kiconedit.cpp:705
msgid ""
"Custom colors\n"
"\n"
"Here you can build a palette of custom colors.\n"
"Double-click on a box to edit the color"
msgstr ""
"pasmaak kleure\n"
"\n"
"hier jy kan bou 'n palet van pasmaak kleure.\n"
"Double-click op 'n boks aan redigeer die kleur"

#: kiconedit.cpp:711
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one.\n"
"\n"
"(Tip: Hold the button down for a few seconds to zoom to a predefined scale"
msgstr ""
"zoem uit\n"
"\n"
"zoem uit deur een.\n"
"\n"
"(leidraad: hou die knoppie ondertoe vir 'n paar sekondes aan zoem aan 'n "
"vooraf gedefinieerde skaal"

#: kiconedit.cpp:715
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one.\n"
"\n"
"(Tip: Hold the button down for a few seconds to zoom to a predefined scale"
msgstr ""
"zoem in\n"
"\n"
"zoem in deur een.\n"
"\n"
"(leidraad: hou die knoppie ondertoe vir 'n paar sekondes aan zoem aan 'n "
"vooraf gedefinieerde skaal"

#: kiconedit.cpp:719
msgid ""
"Toggle grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"wissel rooster\n"
"\n"
"skakel tussen die rooster in die ikoon redigeer rooster op/af"

