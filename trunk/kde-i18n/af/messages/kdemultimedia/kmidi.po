#: kmidi.cpp:605
msgid ""
"Open up or close lower<br>\n"
"part of panel with<br>\n"
"channel display and<br>\n"
"other controls"
msgstr ""
"Open begin van maak toe sagter<br>\n"
"deel van paneel met<br>\n"
"kanaal vertoon en<br>\n"
"ander kontroles"

#: kmidi.cpp:611
msgid "open up the play list editor"
msgstr "open begin die speel lys redigeerder"

#: kmidi.cpp:613
msgid ""
"open up or close<br>\n"
"the display containing info about the<br>\n"
"song being played"
msgstr ""
"open begin of maak toe<br>\n"
"die vertoon bevat inligting aangaande die<br>\n"
"liedjie te wees gespeel"

