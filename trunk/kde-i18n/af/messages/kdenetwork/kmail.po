msgid ""
"_: continuation of \"obtain signature text from\"\n"
"Input Field Below"
msgstr "Invoer Veld Onder"

#: signatureconfigurator.cpp:71
msgid "Obtain signature &text from:"
msgstr "Verkry handtekening teks van:"

#: signatureconfigurator.cpp:102
msgid "S&pecify file:"
msgstr "Spesifiseer lêer:"

