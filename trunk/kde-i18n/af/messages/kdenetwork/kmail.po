msgstr "Waarskuwing as root sertifikaat verstrek in minder as"

#: rc.cpp:278
msgid ""
"<qt>\n"
"<h1>Warn If CA Certificate Expires</h1>\n"
"Select the minimum number of days the CA certificate should be valid without "
"issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""

#: rc.cpp:281
msgid ""
"<qt>\n"
"<h1>Warn If Root Certificate Expires</h1>\n"
"Select the minimum number of days the root certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""

#: rc.cpp:282
msgid "Warn if signer's email address is &not in certificate"
msgstr "Waarskuwing as signer's e-pos adres is nie in sertifikaat"

#: rc.cpp:284
msgid ""
"<qt>\n"
"<h1>Warn If Signer's Email Address Is Not In Certificate</h1>\n"
"If this option is checked, a warning is issued if the email address of the "
"signer is not contained in the certificate used for signing.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Waarskuwing As teken's E-pos Adres is Nie in Sertifikaat</h1>\n"
"As hierdie opsie is nagegaan, 'n waarskuwing is uitgereik As die E-pos Adres "
"van die teken is Nie versamel in die Sertifikaat gebruik word vir "
"getekende.\n"
"<p>\n"
"Dit is aanbeveel na los hierdie opsie geskakel op vir maksimum integriteit.\n"
"</qt>"

