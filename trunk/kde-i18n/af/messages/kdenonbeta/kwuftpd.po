msgstr ""
"Hou 'n sekuriteit log (gevaal aanteken probeerslae etc.) vir anoniem "
"gebruikers (gebruikernaam <i>anoniem</i> of <i>ftp</i>)"

#: Logging.cpp:34
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with restricted access)"
msgstr ""
"Hou 'n sekuriteit log (gevaal aanteken probeerslae etc.) vir gas gebruikers "
"(egte gebruikers met beperking toegang verkry)"

#: Logging.cpp:35
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with unrestricted access)"
msgstr ""
"Hou 'n sekuriteit log (gevaal aanteken probeerslae etc.) vir gas gebruikers "
"(egte gebruikers met onbeperkte toegang verkry)"

#: Logging.cpp:36
msgid "Log to syslog instead of logfiles"
msgstr "Log na syslog in plaas van van loglêers"

#: Logging.cpp:37
msgid "Automatically notify the administrator of uploads from anonymous users"
msgstr ""
"Automaties inkennistelling die administrateur van oplaaie van anoniem "
"gebruikers"

#: Logging.cpp:38
msgid ""
"The address entered here will appear in the <i>From:</i> header of upload "
