msgid "Log security-related messages (failed logins etc.)"
msgstr "Log security-related boodskappe (gevaal inteken etc.)"

#: Logging.cpp:24
msgid ""
"Log commands given by anonymous (username <i>ftp</i> or <i>anonymous</i>) "
"users."
msgstr ""
"Log opdragte gegewe deur anoniem (gebruikernaam <i>ftp</i> of "
"<i>anoniem</i>) gebruikers."

#: Logging.cpp:25
msgid ""
"Log commands given by guest users (users with a real account, but restricted "
"access)."
msgstr ""
"Log opdragte gegewe deur gas gebruikers (gebruikers met 'n egte rekening, "
"maar beperking toegang verkry)."

#: Logging.cpp:26
msgid ""
"Log commands given by real users (users with an unrestricted account on the "
"server"
msgstr ""
"Log opdragte gegewe deur egte gebruikers (gebruikers met 'n onbeperkte "
"rekening op die bediener"

#: Logging.cpp:27
msgid ""
"Log inbound transfers (uploads to the server) by anonymous users (username "
