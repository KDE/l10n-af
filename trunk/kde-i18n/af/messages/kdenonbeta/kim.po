#: rc.cpp:19
msgid ""
"<qt>\n"
"<p>Select the method for ISDN monitoring here:</p>\n"
"<ul>\n"
"<li><p><b>local</b> (default value)<br />\n"
"Use this if your ISDN card is installed in the same computer as you\n"
"run KDE on.\n"
"</p>\n"
"</li>\n"
"<li><p><b>ssh</b><br />\n"
"This is the preferred way to monitor an ISDN card on a remote computer.\n"
"You need to have setup SSH public key authentication to connect to\n"
"the host name you entered below.\n"
"</p>\n"
"</li>\n"
"<li><p><b>rsh</b><br />\n"
"This option is only provided in case you absolutely cannot use SSH nor\n"
"direct TCP connections. It is <b>strongly</b> discouraged to use this.\n"
"</p>\n"
"</li>\n"
"<li><p><b>TCP/IP</b><br />\n"
"A plain TCP connection is made to the host and port you entered below.\n"
"The <i>kimd</i> program is expected to be running on that connection,\n"
"e.g. via <i>inetd</i> or <i>xinetd</i>.\n"
"</p>\n"
"</li>\n"
"</ul>"
msgstr ""

