#: kcmsmserver.cpp:89
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed and if the previous session should be restored when logging in."
msgstr ""

#: rc.cpp:1 rc.cpp:2
msgid "Session Manager"
msgstr "SESSIE BESTUURDER"

#: rc.cpp:3
msgid "Confirm &logout"
msgstr "BEVESTIG &TEKEN AF"

#: rc.cpp:4
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""

#: rc.cpp:5
msgid "&Restore previous session when logging in"
msgstr "&HERSTEL VORIGE SESSIE WANNEER AFTEKEN IN"

#: rc.cpp:6
msgid ""
"Check this option if you want the session manager to save the running "
"session when logging out and restore it on the next login."
msgstr ""
