#: general.cpp:418
msgid "If this option is selected, menus open immediately."
msgstr ""

#: general.cpp:419
msgid "If this option is selected, menus fade in slowly."
msgstr ""

#: general.cpp:420
msgid ""
"If this option is selected, menus are animated to grow to their full size."
msgstr ""

#: general.cpp:421
msgid ""
"If this option is selected, combo boxes are animated to grow to their full "
"size."
msgstr ""

#: general.cpp:422
