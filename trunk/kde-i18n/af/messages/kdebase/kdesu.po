#: kdesu.cpp:54 kdesu.cpp:55
msgid "Specifies the command to run."
msgstr "Spesifiseer die opdrag na hardloop."

#: kdesu.cpp:56
msgid "Run command under target uid if <file> is not writeable."
msgstr "Hardloop opdrag onder teiken uid as <file> is nie skryfbaar."

#: kdesu.cpp:57
msgid "Specifies the target uid."
msgstr "Spesifiseer die teiken uid."

#: kdesu.cpp:58
msgid "Do not keep password."
msgstr "Doen nie hou wagwoord."

#: kdesu.cpp:59
msgid "Stop the daemon (forgets all passwords)."
msgstr "Stop die bediener (vergeet alle wagwoorde)."

#: kdesu.cpp:60
msgid "Enable terminal output (no password keeping)."
msgstr "Aktiveer terminaal uitset (nee wagwoord te hou)."

#: kdesu.cpp:61
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Stel prioriteit waarde: 0 <= prioriteit <= 100, 0 is laagste."

#: kdesu.cpp:62
msgid "Use realtime scheduling."
msgstr "Gebruik intydse skedulering."

#: kdesu.cpp:63
msgid "Let command use existing dcopserver."
msgstr "Laat opdrag gebruik bestaande dcop-bediener."

#: kdesu.cpp:92
msgid "KDE su"
msgstr "Kde su"

#: kdesu.cpp:93
msgid "Runs a program with elevated privileges."
msgstr "Loop 'n program met verhoogde voorregte."

#: kdesu.cpp:96
msgid "Maintainer"
msgstr "Onderhouer"

#: kdesu.cpp:98
msgid "Original author"
msgstr "Oorspronklike outeur"

#: kdesu.cpp:167
#, c-format
msgid "Illegal priority: %1"
msgstr "Onwettige prioriteit: %1"

#: kdesu.cpp:194
msgid "No command specified!"
msgstr "Nee opdrag gespesifiseer!"

#: kdesu.cpp:276
msgid ""
"Su returned with an error!\n"
msgstr ""
"Su teruggestuur met 'n fout!\n"

#: kdesu.cpp:291
msgid "Command:"
msgstr "Opdrag:"

#: kdesu.cpp:296
msgid "realtime: "
msgstr "intydse: "

#: kdesu.cpp:298
msgid "Priority:"
msgstr "Prioriteit:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Hardloop as %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Die aksie jy versoekte verlang aditionele voorregte. Asseblief invoer Die "
"wagwoord vir \"%1\" onder of kliek Ignoreer na gaan voort met jou huidige "
"voorregte."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "Ignoreer"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "Gesprek met su gevaal."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"Die program 'su' is nie gevind!\n"
"Maak seker jou Gids soeklys is stel korrek."

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Jy word nie toegelaat na gebruik 'su'!\n"
"Op sommige sisteme, Jy benodig na wees in 'n spesiaal groep (gereeld: wiel) "
"na gebruik hierdie program."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr "Verkeerd wagwoord! Asseblief probeer weer."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr "Intern fout: Onwettige terug van Su-proses::Checkinstall()"

