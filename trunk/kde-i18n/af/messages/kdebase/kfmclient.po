#: kfmclient.cc:50
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintaks:\n"


#: kfmclient.cc:51
msgid ""
"  kfmclient openURL\n"
"            # Opens a dialog to ask you for the URL\n"
"\n"
msgstr ""
"  kfmclient openURL\n"
"            # Maak 'n dialoog oop wat vir 'n URL vra\n"
"\n"

#: kfmclient.cc:53
msgid ""
"  kfmclient openURL 'url'\n"
"            # Opens a window showing 'url'. If such a window\n"
msgstr ""
"  kfmclient openURL 'url'\n"
"            # Maak 'n venster oop wat 'url' vertoon. Indien so 'n venster\n"

#: kfmclient.cc:55
msgid ""
"            #   exists, it is shown. 'url' may be \"trash:/\"\n"
"            #   to open the trash bin.\n"
"\n"
msgstr ""
"            #   bestaan, sal dit vertoon word. 'url' mag \"trash:/\"\n"
"            #   wees om die gemorsblik te open.\n"
"\n"

#: kfmclient.cc:57
msgid ""
"  kfmclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kfmclient openProperties 'url'\n"
"            # Maak 'n eienskappekieskaart oop\n"
"\n"

#: kfmclient.cc:59
msgid ""
"  kfmclient exec ['url' ['binding']]\n"
"            # Tries to execute 'url'. 'url' may be a usual\n"
"            #   URL, this URL will be opened. You may omit\n"
"            #   'binding'. In this case the default binding\n"
msgstr ""
"  kfmclient exec ['url' ['binding']]\n"
"            # Probeer om 'url' uit te voer. 'url' mag 'n gewone\n"
"            #   URL wees, welke dit geopen sal word. U kan die\n"
"            #   binding uitlos, welke die verstek binding gebruik sal word.\n"

#: kfmclient.cc:63
msgid ""
"            #   is tried. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
msgstr ""
"            #   Natuurlik kan 'url' dié van 'n dokument wees\n"
"            #   of van 'n *.desktop lêer.\n"

#: kfmclient.cc:65
msgid ""
"            #   This way you could for example mount a device\n"
"            #   by passing 'Mount default' as binding to \n"
"            #   'cdrom.desktop'\n"
"\n"
msgstr ""
"            #   Hiervolgens kan u bv. 'n toestel heg deur\n"
"            #   'Mount default' as binding deur te gee aan\n"
"            #   'cdrom.desktop'\n"
"\n"

#: kfmclient.cc:68
msgid ""
"  kfmclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kfmclient move 'src' 'dest'\n"
"            # Skuif die URL 'src' na 'dest'.\n"
"            #   'src' kan 'n lys van URLs wees.\n"

#: kfmclient.cc:71
msgid ""
"            #   'dest' may be \"trash:/\" to move the files\n"
"            #   in the trash bin.\n"
"\n"
msgstr ""
"            #   'dest' mag ook \"trash:/\" wees om die lêers\n"
"            #   na die gemorsblik te skuif.\n"
"\n"

#: kfmclient.cc:73
msgid ""
"  kfmclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"\n"
msgstr ""
"  kfmclient copy 'src' 'dest'\n"
"            # Kopiëer die URL 'src' na 'dest'.\n"
"            #   'src' kan 'n lys van URLs wees.\n"
"\n"

#: kfmclient.cc:76
msgid ""
"  kfmclient sortDesktop\n"
"            # Rearranges all icons on the desktop.\n"
"\n"
msgstr ""
"  kfmclient sortDesktop\n"
"            # Herrangskik alle ikone op die werkskerm.\n"
"\n"

#: kfmclient.cc:78
msgid ""
"  kfmclient selectDesktopIcons x y w h add\n"
"            # Selects the icons on the desktop in the given rectangle\n"
"            # If add is 1, adds selection to the current one\n"
"\n"
msgstr ""
"  kfmclient selectDesktopIcons x y w h add\n"
"            # Selekteer die ikone in die gegewe reghoek op die werkskerm.\n"
"            # Indien add 1 is, voeg die seleksie by die huidige.\n"
"\n"

#: kfmclient.cc:81
msgid ""
"  kfmclient configure\n"
"            # Re-read konqueror's configuration.\n"
"\n"
msgstr ""
"  kfmclient configure\n"
"            # Herlees konqueror se konfigurasie.\n"
"\n"

#: kfmclient.cc:83
msgid ""
"  kfmclient configureDesktop\n"
"            # Re-read kdesktop's configuration.\n"
"\n"
msgstr ""
"  kfmclient configureDesktop\n"
"            # Herlees kdesktop se konfigurasie.\n"
"\n"

#: kfmclient.cc:86
msgid ""
"*** Examples:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** Voorbeelde:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Heg die CDROM\n"
"\n"

#: kfmclient.cc:89
msgid ""
"  kfmclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kfmclient exec file:/home/weis/data/test.html\n"
"             // Maak die lêer met verstek bindings oop.\n"
"\n"

#: kfmclient.cc:91
msgid ""
"  kfmclient exec file:/home/weis/data/test.html Netscape\n"
"             // Maak die lêer met Netscape oop\n"
"\n"
msgstr ""

#: kfmclient.cc:93
msgid ""
"  kfmclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kfmclient exec ftp://localhost/\n"
"             // Maak nuwe venster vir URL oop\n"
"\n"

#: kfmclient.cc:95
msgid ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // Loop emacs\n"
"\n"

#: kfmclient.cc:97
msgid ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CD-ROM's mount directory\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Maak die CDROM se heggids oop\n"
"\n"

#: kfmclient.cc:130 kfmclient.cc:198 kfmclient.cc:217
msgid "Syntax Error: Too few arguments\n"
msgstr "Sintaksfout: Te min parameters\n"

#: kfmclient.cc:146 kfmclient.cc:236 kfmclient.cc:267 kfmclient.cc:277
msgid "Syntax Error: Too many arguments\n"
msgstr "Sintaksfout: Te veel parameters\n"

#: kfmclient.cc:160 kfmclient.cc:190 kfmclient.cc:259
msgid "Syntax Error: Wrong number of arguments\n"
msgstr "Sintaksfout: Verkeerde hoeveelheid parameters\n"

#: kfmclient.cc:286
#, c-format
msgid "Syntax Error: Unknown command '%s'\n"
msgstr "Sintaksfout: Onbekende instruksie '%s'\n"
