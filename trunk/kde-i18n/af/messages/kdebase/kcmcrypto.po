#: crypto.cpp:327
msgid "Use these buttons to more easily configure the SSL encryption settings."
msgstr ""
"Gebruik hierdie knoppies na meer maklik konfigureer die Ssl enkripsie "
"instellings."

#: crypto.cpp:329
msgid "Select the settings found to be most compatible."
msgstr "Kies die instellings gevind na wees mees aanpasbaar."

#: crypto.cpp:331
msgid "Select only the US strong (>= 128 bit) encryption ciphers."
msgstr "Kies slegs die Us sterk (>= 128  bit ) enkripsie versyferaars."

#: crypto.cpp:333
msgid "Select only the weak ciphers (<= 56 bit)."
msgstr "Kies slegs die swak versyferaars (<= 56  bit )."

#: crypto.cpp:335
