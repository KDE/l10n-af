#: behaviour.cpp:46
msgid ""
"<h1>Konqueror Behavior</h1> You can configure how Konqueror behaves as a "
"file manager here."
msgstr ""
"<h1>Konqueror Gedrag</h1> Jy kan konfigureer hoe Konqueror gedrag as 'n "
"lêer bestuurder hier."

