#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b>"
"<P>KDE now supports utilizing older themes from other platforms in your new "
"KDE desktop. The most common type of legacy theme is for the GTK toolkit, "
"which is imported to KDE's Control Center with this utility."
"<P>In order to do this you must specify at least one item: the folder where "
"the pixmaps for the theme is located. You may also have to specify the "
"theme's gtkrc file if it's not in the same folder as the pixmaps. Both are "
"usually in the folder \"gtk\" inside the theme's directory.</QT>"
msgstr ""

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "step 1: spesifiseer tema se bispatroon kabinet:"

#: legacyimport.cpp:36 legacyimport.cpp:62
msgid "Browse"
msgstr "blaai"

#: legacyimport.cpp:51
msgid "Specify pixmap directory"
msgstr "spesifiseer bispatroon gids"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b>"
"<P>A gtkrc file was not found in the specified directory. If it exists "
"somewhere other than where the pixmaps are located enter it here.</QT>"
msgstr ""
"<QT><b>oorgeërfde tema invoerder</b>"
"<P>'n gtkrc lêer was nie gevind in die <-invoer->"
"gespesifiseer gids. as dit bestaan êrens ander as waar die pix-kaarte word "
"<-invoer->geleë invoer dit hier.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "step 2: spesifiseer tema se gtkrc:"

#: legacyimport.cpp:76
