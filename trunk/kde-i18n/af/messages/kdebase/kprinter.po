#: main.cpp:30
msgid "Printer/destination to print on"
msgstr "Drukker/bestemming na druk op"

#: main.cpp:32
msgid "Title/Name for the print job"
msgstr "Titel/Naam vir die druk werk"

#: main.cpp:34
msgid "Number of copies"
msgstr "Nommer van kopieër"

#: main.cpp:35
msgid "Printer option"
msgstr "Drukker opsie"

#: main.cpp:36
msgid "Job output mode (gui, console, none)"
msgstr "Werk uitset modus (gui, konsole, geen)"

#: main.cpp:37
msgid "Print system to use (lpd, cups)"
msgstr "Druk stelsel na gebruik (lpd, cups)"

#: main.cpp:38
msgid "Allow printing from STDIN"
msgstr "Toelaat besig om te druk van Stdin"

#: main.cpp:39
msgid "Do not show the print dialog (print directly)."
msgstr "Doen nie vertoon die druk dialoog (druk direk)."

#: main.cpp:40
msgid "Files to load"
msgstr "Lêers na las"

#: main.cpp:46
msgid "A printer tool for KDE"
msgstr "'n drukker program vir Kde"

#: printwrapper.cpp:59
msgid "Print Information"
msgstr "Druk Informasie"

#: printwrapper.cpp:60
msgid "Print Warning"
msgstr "Druk Waarskuwing"

#: printwrapper.cpp:61
msgid "Print Error"
msgstr "Druk Fout"

#: printwrapper.cpp:67
msgid "Print info"
msgstr "Druk inligting"

#: printwrapper.cpp:67
msgid "Print warning"
msgstr "Druk waarskuwing"

#: printwrapper.cpp:67
msgid "Print error"
msgstr "Druk fout"

#: printwrapper.cpp:152
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""
"'n lêer het al gespesifiseer op die opdrag lyn. Besig om te druk van Stdin "
"sal wees gestremde."

#: printwrapper.cpp:158
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Wanneer te gebruik '--nodialog', jy moet na minste spesifiseer een lêer na "
"druk of gebruik die '--stdin' vlag."

#: printwrapper.cpp:207
msgid "The specified printer or the default printer could not be found."
msgstr "Die gespesifiseer drukker of Die verstek drukker kon nie wees gevind."

#: printwrapper.cpp:209
msgid "Operation aborted."
msgstr "Operasie gekanselleer."

#: printwrapper.cpp:237
msgid "Unable to construct the print dialog."
msgstr "Nie moontlik na opstel die druk dialoog."

#: printwrapper.cpp:277
msgid "Multiple files (%1)"
msgstr "Veelvuldige lêers (%1)"

#: printwrapper.cpp:305
msgid "Unable to open temporary file."
msgstr "Nie moontlik na open tydelike lêer."

#: printwrapper.cpp:320
msgid "Stdin is empty, no job sent."
msgstr "Stdin is leeg, nee werk gestuur."

#: printwrapper.cpp:335
msgid "Error while printing files"
msgstr "Fout terwyl besig om te druk lêers"

#: printwrapper.cpp:338
msgid "<nobr>File(s) sent to printer <b>%1</b>.</nobr>"
msgstr "<nobr>Lêer(s) gestuur na drukker <b>%1</b>.</nobr>"
