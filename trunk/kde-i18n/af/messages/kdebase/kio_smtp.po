#: smtp.cc:262 smtp.cc:331
msgid "The sender address is missing."
msgstr "Die stuurder adres is kort."

#: smtp.cc:273
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "smtp protokol::smtp_open gevaal (%1)"

#: smtp.cc:282
msgid ""
"The server did not accept the sender address.\n"
"The server responded: \"%1\""
msgstr ""
"Die bediener het nie aanvaar Die stuurder adres.\n"
"Die bediener reageer: \"%1\""

#: smtp.cc:305
msgid ""
"The attempt to start sending the message content failed.\n"
"The server responded: \"%1\""
msgstr ""
"Die poog na begin stuur Die boodskap inhoud gevaal.\n"
"Die bediener reageer: \"%1\""

#: smtp.cc:379
msgid ""
"The message content was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Die boodskap inhoud was nie aanvaar.\n"
"Die bediener reageer: \"%1\""

#: smtp.cc:396
msgid ""
"One of the recipients was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"Een van die ontvangers was nie aanvaar.\n"
"die bediener reageer: \"%1\""

#: smtp.cc:464 smtp.cc:487
msgid "Invalid SMTP response received."
msgstr "Ongeldige Smtp antwoord ontvang."

#: smtp.cc:520
msgid "Invalid SMTP response received: \"%1\""
msgstr "Ongeldige Smtp antwoord ontvang: \"%1\""

#: smtp.cc:571
msgid "The server did not accept the connection: \"%1\""
msgstr "Die bediener het nie aanvaar Die verbinding: \"%1\""

#: smtp.cc:609 smtp.cc:657
msgid "The server responded: \"%1\""
msgstr "Die bediener reageer: \"%1\""

#: smtp.cc:633
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Jou Smtp bediener maak aanspraak na ondersteun Tls, maar onderhandeling was "
"onsuksesvol.\n"
"Jy kan deaktiveer Tls in Kde te gebruik die kripto instellings module."

#: smtp.cc:638
msgid "Connection Failed"
msgstr "Verbinding Gevaal"

#: smtp.cc:678
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Jou Smtp bediener doen nie ondersteun Tls. Deaktiveer Tls, as jy wil hê na "
"konnekteer sonder om te enkripsie."

#: smtp.cc:690
msgid "Username and password for your SMTP account:"
msgstr "Gebruikernaam en wagwoord vir jou Smtp rekening:"

#: smtp.cc:692
msgid "When prompted, you ran away."
msgstr "Wanneer gepor, jy hardloop weg."

#: smtp.cc:739
msgid "No compatible authentication methods found."
msgstr "Nee aanpasbaar geldigheidsverklaring metodes gevind."

#: smtp.cc:760
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""

#: smtp.cc:790
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded: \"%1\""
msgstr ""
"Geldigheidsverklaring gevaal.\n"
"Mees waarskynlik die wagwoord is verkeerde.\n"
"die bediener reageer: \"%1\""
