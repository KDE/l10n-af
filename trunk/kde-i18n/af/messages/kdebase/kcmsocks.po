#: rc.cpp:1
msgid "Socks"
msgstr "SOCKS"

#: rc.cpp:2
msgid "&Enable SOCKS support"
msgstr "&AKTIVEER SOCKS ONDERSTEUN"

#: rc.cpp:3
msgid ""
"Check this to enable SOCKS4 and SOCKS5 support in KDE applications and I/O "
"subsystems."
msgstr ""

#: rc.cpp:4
msgid "SOCKS Implementation"
msgstr "SOCKS IMPLEMENTERING"

#: rc.cpp:5
msgid "A&uto detect"
msgstr "A&uto VERKLIK"

#: rc.cpp:6
msgid ""
"If you select Autodetect, then KDE will automatically search for an "
"implementation of SOCKS on your computer."
msgstr ""

#: rc.cpp:7
msgid "Use &NEC SOCKS"
msgstr "GEBRUIK &NEC SOCKS"

#: rc.cpp:8
msgid "This will force KDE to use NEC SOCKS if it can be found."
msgstr "HIERDIE SAL FORSEER KDE AAN GEBRUIK NEC SOCKS AS DIT KAN WEES GEVIND."

#: rc.cpp:9
msgid "Use &Dante"
msgstr "GEBRUIK &DANTE"

#: rc.cpp:10
msgid "This will force KDE to use Dante if it can be found."
msgstr "HIERDIE SAL FORSEER KDE AAN GEBRUIK DANTE AS DIT KAN WEES GEVIND."

#: rc.cpp:11
msgid "Use &custom library"
msgstr "GEBRUIK &PASMAAK BIBLIOTEEK"

#: rc.cpp:12
msgid ""
"Select custom if you wish to use an unlisted SOCKS library. Please note that "
"this may not always work as it depends on the API of the library which you "
"specify (below)."
msgstr ""

#: rc.cpp:13
msgid "&Path:"
msgstr "&GIDS SOEKLYS:"

#: rc.cpp:14
msgid "Enter the path to an unsupported SOCKS library."
msgstr "INVOER DIE GIDS SOEKLYS AAN 'N NIE ONDERSTEUNDE SOCKS BIBLIOTEEK."

#: rc.cpp:15
msgid "Additional library search paths"
msgstr "ADITIONELE BIBLIOTEEK SOEKTOG PATHS"

#: rc.cpp:16
msgid ""
"Here you can specify additional directories to search for the SOCKS "
"libraries.  /usr/lib, /usr/local/lib, /usr/local/socks5/lib and "
"/opt/socks5/lib are already searched by default."
msgstr ""

#: rc.cpp:17
msgid "Path"
msgstr "GIDS SOEKLYS"

#: rc.cpp:18
msgid "This is the list of additional paths that will be searched."
msgstr "HIERDIE IS DIE lISt VAN ADITIONELE PATHS WAT SAL WEES GESOEKTE."

#: rc.cpp:19
msgid "&Add"
msgstr "&VOEG BY"

#: rc.cpp:21
msgid "&Test"
msgstr "&TOETS"

#: rc.cpp:22
msgid "Click here to test SOCKS support."
msgstr "KLIEK HIER AAN TOETS SOCKS ONDERSTEUN."

#: socks.cpp:96
msgid "These changes will only apply to newly started applications."
msgstr ""

#: socks.cpp:98 socks.cpp:131 socks.cpp:136
msgid "SOCKS Support"
msgstr "SOCKS ONDERSTEUN"

#: socks.cpp:130
msgid "Success!  SOCKS was found and initialized."
msgstr ""

#: socks.cpp:135
msgid "Sorry, SOCKS could not be loaded."
msgstr ""

#: socks.cpp:268
msgid ""
"<h1>socks</h1> This module allows you to configure KDE support for a SOCKS "
"server or proxy."
msgstr ""
