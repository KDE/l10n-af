#: runapplet.cpp:58
msgid "Run command:"
msgstr "Hardloop opdrag:"

#: runapplet.cpp:177
msgid "< Run"
msgstr "< Hardloop"

#: runapplet.cpp:184
msgid "Run >"
msgstr "Hardloop >"

#: runapplet.cpp:232
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Jy het na invoer 'n opdrag na uitvoer of 'n Url na wees geöpende eerste."

#: runapplet.cpp:243
msgid ""
"Unable to logout properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"Nie moontlik na teken af behoorlik.\n"
"Die sessie bestuurder kan nie wees geskakel. Jy kan probeer na forseer 'n "
"afskakel deur gedruk Ctrl+Alt+Backspace. Nota, egter, wat jou huidige sessie "
"sal nie wees gestoor met 'n geforseer afskakel."

#: runapplet.cpp:274
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>Die program naam of opdrag <b>%1</b>\n"
"kan nie wees gevind. Asseblief korrek Die opdrag\n"
"of Url en probeer weer</qt>"

#: runapplet.cpp:286
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>Kon nie hardloop <b>%1</b>.\n"
"Asseblief korrek die opdrag of Url en probeer weer.</qt>"
