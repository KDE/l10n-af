#: index.docbook:4
#, no-c-format
msgid "&ktimemon;"
msgstr "&ktimemon;"

#: index.docbook:7
#, no-c-format
msgid ""
"<firstname>Martin</firstname> <surname>Maierhofer</surname> <affiliation> "
