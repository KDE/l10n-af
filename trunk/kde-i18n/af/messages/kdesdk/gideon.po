#: parts/kwrite-part/kwrite/kwdialog.cpp:384
msgid "Wrap Words At:"
msgstr "Oorvloei Woorde Na:"

#: parts/kwrite-part/kwrite/kwdialog.cpp:388
msgid "Tab Width:"
