msgstr "Atan2(0.5;1.0) gelyk aan 1.107149"

#: xml_doc.cc:1926
msgid "ATAN2(-0.5;2.0) equals 1.815775"
msgstr "Atan2(-0.5;2.0) gelyk aan 1.815775"

