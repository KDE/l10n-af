#: rc.cpp:58
msgid "Page Borders"
msgstr "Bladsy Grense"

#: rc.cpp:59
msgid "You can enter the size of the right border here."
msgstr "Jy kan invoer die grootte van die regterkant grens hier."

#: rc.cpp:60
msgid "&Top:"
msgstr "Bo:"

#: rc.cpp:61
msgid "You can enter the size of the top border here."
msgstr "Jy kan invoer die grootte van die bo grens hier."

#: rc.cpp:62
