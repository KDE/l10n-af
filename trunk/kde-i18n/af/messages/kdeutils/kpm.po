#: qps.C:912
msgid ""
"The \"nice\" value should be\n"
"in the range -20 to 20."
msgstr ""
"Die \"oulike\" waarde moet wees\n"
"in Die omvang -20 na 20."

#: qps.C:930
msgid ""
"You do not have permission to renice\n"
"process %1 (%2).\n"
"Only the process owner and the super-user are\n"
"allowed to do that."
msgstr ""
"Jy doen nie het reg na maak netjies\n"
"proses %1 (%2).\n"
"Slegs die proses eienaar en die super-user word\n"
"toegelaat na doen wat."

#: qps.C:937
msgid ""
"Only the super-user may lower\n"
"the nice value of a process."
msgstr ""
"Slegs die super-user dalk mag sagter\n"
"die oulike waarde van 'n proses."

#: qps.C:957
msgid ""
"Only the super-user may change the\n"
"scheduling policy and static priority."
msgstr ""
"Slegs die super-user dalk mag verander die\n"
"skedulering beleid en statiese prioriteit."

#: qps.C:987
msgid ""
"You do not have permission to change the\n"
"scheduling and/or priority of process %1 (%2).\n"
"Only the super-user may do that."
msgstr ""
"Jy doen nie het reg na verander die\n"
"skedulering en/van prioriteit van proses %1 (%2).\n"
"Slegs die super-user dalk mag doen wat."

#: qps.C:1027
msgid ""
"You do not have permission to send a signal to\n"
"process %1 (%2).\n"
"Only the super-user and the owner of the process\n"
"may send signals to it."
msgstr ""
"Jy doen nie het reg na stuur 'n sein na\n"
"proses %1 (%2).\n"
"Slegs die super-user en die eienaar van die proses\n"
"dalk mag stuur syne na dit."

