msgstr "voeg by opdrag..."

#: plugin_kateinsertcommand.cpp:129
msgid "A process is currently being executed."
msgstr "'n proses is huidiglik te wees uitgevoerde."

#: plugin_kateinsertcommand.cpp:129
msgid "Error!"
msgstr "fout!"

#: plugin_kateinsertcommand.cpp:211
msgid "Could not kill command :o(("
msgstr "kon nie stop opdrag :o(("

#: plugin_kateinsertcommand.cpp:211 plugin_kateinsertcommand.cpp:249
msgid "Oops!"
msgstr "oeps!"

#: plugin_kateinsertcommand.cpp:217
msgid "Executing command:"
msgstr "uitvoer van opdrag:"

#: plugin_kateinsertcommand.cpp:217
msgid "Press Cancel to abort"
msgstr "druk kanseleer aan staak"

#: plugin_kateinsertcommand.cpp:249
#, c-format
msgid "Command exited with status %1"
msgstr "opdrag uitgegaan met status %1"

#: plugin_kateinsertcommand.cpp:285
msgid "Insert Command"
msgstr "voeg by opdrag"

#: plugin_kateinsertcommand.cpp:292
msgid "Enter &command:"
msgstr "invoer opdrag:"

#: plugin_kateinsertcommand.cpp:302
msgid "Choose &working directory:"
msgstr "kies werksaam gids:"

#: plugin_kateinsertcommand.cpp:312
msgid "Insert Std&Err messages"
msgstr "voeg by stderr boodskappe"

#: plugin_kateinsertcommand.cpp:315
msgid "&Print command name"
msgstr "druk opdrag naam"

#: plugin_kateinsertcommand.cpp:319
msgid ""
"Enter the shell command, the output of which you want inserted into your "
"document. Feel free to use a pipe or two if you're in that mood;-)"
msgstr ""

#: plugin_kateinsertcommand.cpp:320
msgid ""
"Sets the working directory of the command. The command executed is 'cd <dir>"
" && <command>'"
msgstr ""
"verstel die werksaam gids van die opdrag. die opdrag uitgevoerde is 'cd <dir>"
" && <opdrag>'"

#: plugin_kateinsertcommand.cpp:321
msgid ""
"Check this if you want the error output from <command> inserted too.\n"
"Some commands, such as locate, print everything to STDERR"
msgstr ""
"bevestig hierdie as jy wil hê die fout uitset van <command> ingesit te.\n"
"sommige opdragte, soos as opspoor, druk alles aan stderr"

#: plugin_kateinsertcommand.cpp:322
msgid ""
"If you check this, the command string will be printed followed by a newline "
"before the output."
msgstr ""

#: plugin_kateinsertcommand.cpp:361
msgid "Remember"
msgstr "onthou"

#: plugin_kateinsertcommand.cpp:363
msgid "&Commands"
msgstr "opdragte"

#: plugin_kateinsertcommand.cpp:370
msgid "Start In"
msgstr "begin in"

#: plugin_kateinsertcommand.cpp:372
msgid "Application &working directory"
msgstr "aansoek werksaam gids"

#: plugin_kateinsertcommand.cpp:373
msgid "&Document directory"
msgstr "dokument gids"

#: plugin_kateinsertcommand.cpp:374
msgid "&Latest used working directory"
msgstr "nuutste gebruik word werksaam gids"

#: plugin_kateinsertcommand.cpp:381
msgid ""
"Sets the number of commands to remember. The command history is saved over "
"sessions."
msgstr ""
"verstel die nommer van opdragte aan onthou. die opdrag geskiedenis is gestoor bo "
"sessies."

#: plugin_kateinsertcommand.cpp:382
msgid ""
"<qt>"
"<p>Decides what is suggested as <em>working directory</em> for the "
"command.</p>"
"<p><strong>Application Working Directory (default):</strong> The directory "
"from which you launched the application hosting the plugin, usually your "
"home directory.</p>"
"<p><strong>Document Directory:</strong> The directory of the document. Used "
"only for local documents."
"<p><strong>Latest Working Directory:</strong> The directory used last time "
"you used this plugin.</p></qt>"
msgstr ""