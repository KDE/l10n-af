#: plugin_katexmltools.cpp:417
msgid "Assign Meta DTD in XML Format"
msgstr "Toeken Meta Dtd in Xml Formaat"

#: plugin_katexmltools.cpp:420
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr ""
"Die huidige lêer het al geïdentifiseer as 'n dokument van tipe \"%1\". Die "
"meta Dtd vir hierdie dokument tipe sal nou wees gelaai."

#: plugin_katexmltools.cpp:423
msgid "Loading XML Meta DTD"
msgstr "Laaiïng van Xml Meta Dtd"

#: plugin_katexmltools.cpp:446
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "Die lêer '%1' kon nie wees geöpende. Die bediener teruggestuur 'n fout."

#: plugin_katexmltools.cpp:448 pseudo_dtd.cpp:51 pseudo_dtd.cpp:60
msgid "XML Plugin Error"
msgstr "Xml Inplak Fout"

#: plugin_katexmltools.cpp:916
msgid "Insert XML Element"
msgstr "Voeg by Xml Element"

#: plugin_katexmltools.cpp:939
msgid ""
"Enter XML tag name and attributes. The \"<\", \">\" and closing tag will be "
"supplied."
msgstr ""
"Invoer Xml etiket naam en eienskappe. Die \"<\", \">\" en maak toe etiket "
"sal wees verskaf."

#: pseudo_dtd.cpp:49
#, fuzzy
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr ""
"Die lêer '%1' kon nie wees gelees. Asseblief bevestig wat Die lêer is "
"well-formed Xml.\n"

#: pseudo_dtd.cpp:55
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr ""
"Die lêer '%1' is nie in Die verwag formaat. Asseblief bevestig wat Die "
"lêer is van hierdie tipe:\n"
"-// norman  walsh//Dtd dtdparse V2.0//En\n"
"Jy kan produseer soos lêers met dtdparse. Sien Die Kate Inplak dokumentasie "
"vir meer informasie."

#: pseudo_dtd.cpp:70
msgid "Analyzing meta DTD..."
msgstr "Besig om te analiseer meta Dtd..."

