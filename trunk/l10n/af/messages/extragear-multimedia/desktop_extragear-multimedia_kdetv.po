#: clients/applet/kdetvapplet.desktop:4
msgid "Name=kdetv Applet"
msgstr "Name=KDE TV Programmetjie"

#: clients/applet/kdetvapplet.desktop:5
msgid "Comment=A television for your panel."
msgstr "Comment='n Televisie op jou skerm"

#: clients/kdetv/kdetv.desktop:6
msgid "Name=kdetv"
msgstr "Name=KDE TV"

#: clients/kdetv/kdetv.desktop:7
msgid "GenericName=TV Viewer"
msgstr "GenericName=TV Kyker"

#: clients/kpart/kdetvpart.desktop:3
msgid "Name=kdetv Part"
msgstr "Name=KDE TV Deel"

#: clients/panelextension/kdetvpanelextension.desktop:4
msgid "Name=kdetv Panelextension"
msgstr "Name=KDE TV Skerm uitbreiding"

#: clients/panelextension/kdetvpanelextension.desktop:5
msgid "Comment=A Kicker extension that displays a TV."
msgstr "Comment='n Kicker uitbreiding wat 'n TV program vertoon"

#: clients/screensaver/kdetvscreensaver.desktop:9
msgid "Name=kdetv Screen Saver"
msgstr "Name=KDE TV skerm bewaarder"

#: clients/screensaver/kdetvscreensaver.desktop:10
msgid "Comment=A screen saver that displays a TV"
msgstr "Comment='n Skerm bewaarder wat 'n TV program vertoon"

#: clients/screensaver/kdetvscreensaver.desktop:14
msgid "Name=Setup..."
msgstr "Name=Stel op..."

#: clients/screensaver/kdetvscreensaver.desktop:19
msgid "Name=Display in specified window"
msgstr "Name=Vertoon in 'n spesifieke venster"

#: clients/screensaver/kdetvscreensaver.desktop:23
msgid "Name=Display in root window"
msgstr "Name=Vertoon in die 'root' venster"

#: plugins/channel/csv/kdetv_csvchannels.desktop:9
msgid "Name=CSV Channel File Plugin"
msgstr "Name=CSV kanaal lêer inprop module"

#: plugins/channel/csv/kdetv_csvchannels.desktop:10
msgid ""
"Comment=This stores your channel files in CSV (comma separated variables) "
"format."
msgstr ""
"Comment=Hierdie stoor jou kanaal lêers in CSV ('comma separated variables') "
"formaat."

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:9
msgid "Name=KWinTV Legacy Channel File Plugin"
msgstr "Name=Verouderde KWinTV kanaal lêer formaat inprop module"

#: plugins/channel/kwintv/kdetv_kwintvchannels.desktop:10
msgid ""
"Comment=This allows you to use your legacy KWinTV format channel files in "
"Kdetv."
msgstr ""
"Comment=Hierdie laat jou toe om verouderde KWinTV kanaal lêer formaat in KDE TV "
"te gebruik."

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:9
msgid "Name=xawtv Channel File Plugin"
msgstr "Name=xawtv kanaal lêer formaat inprop module"

#: plugins/channel/xawtv/kdetv_xawtvchannels.desktop:10
msgid "Comment=This loads your xawtv format channel files in kdetv."
msgstr ""
"Comment=Hierdie laat jou toe om xawtv kanaal lêer formaat in KDE TV te gebruik."

#: plugins/channel/xml/kdetv_xmlchannels.desktop:9
msgid "Name=XML Channel File Plugin"
msgstr "Name=XML kanaal lêer formaat inprop module"

#: plugins/channel/xml/kdetv_xmlchannels.desktop:10
msgid ""
"Comment=This stores your channel files in XML format.  This is the standard "
"file format for kdetv."
msgstr ""
"Comment=Hierdie stoor jou kanaal lêers in XML formaat. Dit is die standaard "
"lêer formaat vir KDE TV."

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:9
msgid "Name=Zapping Channel File Plugin"
msgstr "Name=Zapping kanaal lêer formaat inprop module"

#: plugins/channel/zapping/kdetv_zappingchannels.desktop:10
msgid ""
"Comment=This loads/stores your channel files in XML format zapping "
"(zapping.sf.net) uses."
msgstr ""
"Comment=Hierdie laat jou toe om die Zapping XML kanaal lêer formaat in KDE TV "
"te gebruik. (sien http://zapping.sf.net)"

#: plugins/filter/bilinear/kdetv_bilinear.desktop:10
msgid "Name=Bilinear Deinterlacing"
msgstr "Name=Biliniêre Deinterlacing"

#: plugins/filter/bilinear/kdetv_bilinear.desktop:11
#: plugins/filter/linearblend/kdetv_linearblend.desktop:11
msgid "Comment=Low CPU usage, modest quality"
msgstr "Comment=Lae CPU gebruik - aanvaarbare kwaliteit"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:10
msgid "Name=Chroma Kill"
msgstr "Name=Verwyder Chroma"

#: plugins/filter/chromakill/kdetv_chromakill.desktop:11
msgid "Comment=Converts video to black and white"
msgstr "Comment=Skakel video om na swart en wit"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:10
msgid "Name=Color Inversion"
msgstr "Name=Kleur omskakeling"

#: plugins/filter/colourinversion/kdetv_colourinversion.desktop:11
msgid "Comment=Inverts video colors"
msgstr "Comment=Skakel video kleur om na negatiewe"

#: plugins/filter/greedy/kdetv_greedy.desktop:10
msgid "Name=Greedy (Low Motion) Deinterlacing"
msgstr "Name=Gulsige Deinterlacing (Vir min beweging)"

#: plugins/filter/greedy/kdetv_greedy.desktop:11
#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:11
msgid ""
"Comment=Higher CPU usage, good quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Comment=Hoë CPU gebruik - goeie kwaliteit. Aangepasde kode vanaf "
"http://www.dscaler.org"

#: plugins/filter/greedy2frame/kdetv_greedy2frame.desktop:10
msgid "Name=Greedy2Frame Deinterlacing"
msgstr "Name=Gulsige 2 Raam Deinterlacing"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:10
msgid "Name=Greedy (High Motion) Deinterlacing"
msgstr "Name=Gulsige Deinterlacing (Vir baie beweging)"

#: plugins/filter/greedyh/kdetv_greedyh.desktop:11
msgid ""
"Comment=High CPU usage, great quality (adapted from DScaler www.dscaler.org)"
msgstr ""
"Comment=Hoë CPU gebruik - uitstekende kwaliteit. Aangepasde kode vanaf "
"http://www.dscaler.org"

#: plugins/filter/linearblend/kdetv_linearblend.desktop:10
msgid "Name=Linear Blend Deinterlacing"
msgstr "Name=Liniêre meng Deinterlacing"

#: plugins/filter/mirror/kdetv_mirror.desktop:10
msgid "Name=Mirror"
msgstr "Name=Spieël"

#: plugins/filter/mirror/kdetv_mirror.desktop:11
msgid "Comment=Mirrors video image"
msgstr "Comment=Maak 'n spieël beeld van die video"

#: plugins/filter/none/kdetv_none.desktop:10
msgid "Name=No Deinterlacing"
msgstr "Name=Geen Deinterlacing"

#: plugins/filter/none/kdetv_none.desktop:11
msgid "Comment="
msgstr "Comment="

#: plugins/filter/overscan/kdetv_overscan.desktop:10
msgid "Name=Overscan"
msgstr "Name=Oor skandeer"

#: plugins/filter/overscan/kdetv_overscan.desktop:11
msgid "Comment=Cuts away noise from image borders"
msgstr "Comment=Kap randte van die beeld af wat ruis bevat"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:10
msgid "Name=Sharpness"
msgstr "Name=Verskerp"

#: plugins/filter/sharpness/kdetv_sharpness.desktop:11
msgid "Comment=Increases sharpness of video image"
msgstr "Comment=Verhoog die skerpheid van die video beeld"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:10
msgid "Name=TomsMoComp Deinterlacing"
msgstr "Name=TomsMoComp Deinterlacing"

#: plugins/filter/tomsmocomp/kdetv_tomsmocomp.desktop:11
msgid ""
"Comment=Very high CPU usage, great quality (adapted from DScaler "
"www.dscaler.org)"
msgstr ""
"Comment=Baie hoë CPU gebruik, uitstekende kwaliteit. Aangepasde kode vanaf "
"http://www.dscaler.org"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:9
msgid "Name=Channelsuite Plugin"
msgstr "Name=Channelsuite inprop module"

#: plugins/misc/channelsuite/kdetv_channelsuite.desktop:10
msgid "Comment=Channelsuite management"
msgstr "Comment=Channelsuite bestuur"

#: plugins/misc/simon/kdetv_simon.desktop:9
msgid "Name=Closed Captioning Plugin"
msgstr "Name=Onderskrif inprop module"

#: plugins/misc/simon/kdetv_simon.desktop:10
msgid "Comment=Simon says: \"This provides closed captioning support.\""
msgstr "Comment=Simon sê: Hierdie verskaf onderskrif ondersteuning."

#: plugins/misc/telex/kdetv_telex.desktop:9
msgid "Name=Teletext Plugin"
msgstr "Name=Teletext inprop module"

#: plugins/misc/telex/kdetv_telex.desktop:10
msgid "Comment=Shows Telext pages"
msgstr "Comment=Vertoon Teletext bladsye"

#: plugins/mixer/alsa/kdetv_alsa.desktop:10
msgid "Name=ALSA Mixer Plugin"
msgstr "Name=ALSA klank meng inprop module"

#: plugins/mixer/alsa/kdetv_alsa.desktop:11
msgid "Comment=This provides support for ALSA mixer devices."
msgstr "Comment=Hierdie verskaf ondersteuning vir ALSA klank meng toestelle"

#: plugins/mixer/oss/kdetv_oss.desktop:10
msgid "Name=OSS Mixer Plugin"
msgstr "Name=OSS klank meng inprop module"

#: plugins/mixer/oss/kdetv_oss.desktop:11
msgid "Comment=This provides support for OSS audio mixer devices."
msgstr "Comment=Hierdie verskaf ondersteuning vir OSS klank meng toestelle"

#: plugins/osd/elegant/kdetv_elegant.desktop:9
msgid "Name=Elegant On-Screen Display Plugin"
msgstr "Name=Elegante op skerm vertoon inprop module"

#: plugins/osd/elegant/kdetv_elegant.desktop:10
msgid "Comment=This provides an elegant on-screen display."
msgstr "Comment=Hierdie verskaf 'n elegante op skerm vertoon"

#: plugins/osd/haze/kdetv_haze.desktop:9
msgid "Name=Haze On-Screen Display Plugin"
msgstr "Name=Haze op skerm vertoon inprop module"

#: plugins/osd/haze/kdetv_haze.desktop:10
msgid "Comment=This provides a simple on-screen display."
msgstr "Comment=Hierdie verskaf 'n eenvoudige op skerm vertoon"

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:10
msgid "Name=libZVBI VBI Decoder Plugin"
msgstr "Name=libZVBI VBI dekodeerder inprop module"

#: plugins/vbi/libzvbidecoder/kdetv_libzvbidecoder.desktop:11
msgid "Comment=libZVBI VBI decoding backend."
msgstr "Comment=libZVBI VBI dekodeerder agterkant"

#: plugins/video/v4l/kdetv_v4l.desktop:9
msgid "Name=Video4Linux Plugin"
msgstr "Name=Video4Linux inprop module"

#: plugins/video/v4l/kdetv_v4l.desktop:10
msgid ""
"Comment=This enables you to view video streams from a Video4Linux device."
msgstr ""
"Comment=Hierdie laat jou toe om na video strome vanaf 'n Video4Linux toestel te "
"kyk."

#: plugins/video/v4l2/kdetv_v4l2.desktop:9
msgid "Name=Video4Linux2 Plugin"
msgstr "Name=Video4Linux2 inprop module"

#: plugins/video/v4l2/kdetv_v4l2.desktop:10
msgid ""
"Comment=This enables you to view video streams from a Video4Linux2 device."
msgstr ""
"Comment=Hierdie laat jou toe om na video strome vanaf 'n Video4Linux2 toestel "
"te kyk"

#: plugins/video/xv/kdetv_xv.desktop:9
msgid "Name=XVideo Plugin"
msgstr "Name=XVideo inprop module"

#: plugins/video/xv/kdetv_xv.desktop:10
msgid ""
"Comment=This enables you to view video streams from the XVideo subsystem of an "
"X11 server.  It requires Xv support for your tuner."
msgstr ""
"Comment=Hierdie laat jou toe om na video strome van die X11 bediener se XVideo "
"substelsel te kyk. LW: Die TV kaart moet Xv ondersteuning hê."
