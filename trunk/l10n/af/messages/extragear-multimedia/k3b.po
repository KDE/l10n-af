#: option/k3bpatternoptiontab.cpp:365
msgid ""
"<p><b>Pattern special strings:</b>"
"<ul>\n"
"<li>%a - artist of the track\n"
"<li>%t - title of the track\n"
"<li>%n - track number\n"
"<li>%e - extended information about the track\n"
"<li>%g - genre of the CD\n"
"<li>%r - album artist (differs from %a only on soundtracks or compilations)\n"
"<li>%m - album title\n"
"<li>%x - extended information about the CD\n"
"<li>%d - current date\n"
"</ul>"
msgstr ""
"<p><b>Spesiale patroon stringe:</b>"
"<ul>\n"
"<li>%a - kunstenaar van die snit\n"
"<li>%t - titel van die snit\n"
"<li>%n - snit nommer\n"
"<li>%e - breedvoerige inligting aangaande die snit\n"
"<li>%g - tipe musiek op die CD\n"
"<li>%r - album kunstenaar (verskil van %a as dit 'n samestelling of film "
"klankbaan is)\n"
"<li>%m - album titel\n"
"<li>%x - breedvoerige inligting aangaande die CD\n"
"<li>%d - huidige datum\n"
"</ul>"

