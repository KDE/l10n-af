#: kpgeneralpage.cpp:123
msgid ""
" <qt>  "
"<p><b>\"General\"</b> </p>  "
"<p>This dialog page contains <em>general</em> print job settings. General "
"settings are applicable to most printers, most jobs  and most job file types.  "
"<p>To get more specific help, enable the \"WhatsThis\" cursor and click on any "
"of the  text labels or GUI elements of this dialog.  </qt>"
msgstr ""
" <qt>  "
"<p><b>\"Algemeen\"</b> </p>  "
"<p>Hierdie dialoog bladsy bevat <em>algemene</em> druk taak verstellings. "
"Algemene instellings is van toepassing op die meeste drukkers, meeste take en "
"meeste taak lêer tipes.  "
"<p>Om meer spesifieke hulp te kry, aktiveer die \"WatisDit\" kursor en kliek op "
"enige van die teks etikette of GUI elemente van hierdie dialoog.  </qt>"

#: kpgeneralpage.cpp:131
msgid ""
" <qt>  "
"<p><b>Page size:</b> Select paper size to be printed on from  the drop-down "
"menu. </p> "
"<p>The exact list of choices depends on the printer driver (\"PPD\") you have "
"installed.</p>  "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o PageSize=...         # examples: \"A4\" or \"Letter\"  </pre> </p>  "
"</qt>"
msgstr ""
" <qt>  "
"<p><b>Papier grootte:</b> Kies papier grootte waarop gedruk moet word vanaf die "
"aftuimel kieslys. </p> "
"<p>Die presiese lys van keuses hang af van die drukker drywer (\"PPD\") wat jy "
"installeer het.</p>  "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o BladsyGrootte=...         # voorbeelde: \"A4\" of \"Brief\"  </pre> "
"</p>  </qt>"

#: kpgeneralpage.cpp:144
msgid ""
" <qt>  "
"<p><b>Paper type:</b> Select paper type to be printed on from  the drop-down "
"menu. </p> "
"<p>The exact list of choices depends on the printer driver (\"PPD\") you have "
"installed. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o MediaType=...        # example: \"Transparency\"  </pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Papier tipe:</b> Kies papier tipe waarop gedruk moet word vanf die "
"aftuimel kieslys. </p> "
"<p>Die presiese lys van keuses hang af van die drukker drywer (\"PPD\") wat jy "
"installeer het. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o MediaTipe=...        # voorbeeld: \"Transpirant\"  </pre> </p>  "
"</qt>"

#: kpgeneralpage.cpp:157
msgid ""
" <qt>  "
"<p><b>Paper source:</b> Select paper source tray for the paper to be printed on "
"from the drop-down menu.  "
"<p>The exact list of choices depends on the printer driver (\"PPD\") you have "
"installed. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o InputSlot=...        # examples: \"Lower\" or \"LargeCapacity\"  "
"</pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Papier bron:</b> Kies papier bron laai vir die papier waarop gedruk moet "
"word vanaf die aftuimel kieslys.  "
"<p>Die presiese lys van keuses hang af van die drukker drywer (\"PPD\") wat jy "
"installeer het. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o InsetGleuf=...        # voorbeelde: \"Laer\" of \"GrootKapasiteit\" "
" </pre> </p>  </qt>"

#: kpgeneralpage.cpp:170
msgid ""
" <qt>  "
"<p><b>Image Orientation:</b> Orientation of the printed  page image on your "
"paper is controlled by the radio buttons. By default,  the orientation is <em>"
"Portrait</em>  "
"<p>You can select 4 alternatives:  "
"<ul>  "
"<li> <b>Portrait.</b>.Portrait is the default setting. </li>  "
"<li> <b>Landscape.</b> </li>  "
"<li> <b>Reverse Landscape.</b> Reverse Landscape prints the images upside down. "
"</li>  "
"<li> <b>Reverse Portrait.</b> Reverse Portrait prints the image upside "
"down.</li>  </ul>  The icon changes according to your selection.</p> "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o orientation-requested=...       # examples: \"landscape\" or "
"\"reverse-portrait\"  </pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Beeld Orientasie:</b> Orientasie van die gedrukte bladsy beeld op jou "
"papier word beheer deur die radio knoppies. By verstek is die orientasie <em>"
"Portret</em>  "
"<p>Jy kan 4 alternatiewe kies:  "
"<ul>  "
"<li> <b>Portret.</b>.Portret is die verstek verstelling. </li>  "
"<li> <b>Landskap.</b> </li>  "
"<li> <b>Agterstevoor Landskap.</b> Agterstevoor Landskap druk die beelde "
"onderstebo. </li>  "
"<li> <b>Agterstevoor Portret.</b> Agterstevoor Portret druk die beeld "
"onderstebo.</li>  </ul>  Die ikoon verander na gelang van jou keuse.</p> "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o orientasie-aangevra=...       # voorbeelde: \"landskap\" of "
"\"agterstevoor-portret\"  </pre> </p>  </qt>"

#: kpgeneralpage.cpp:191
msgid ""
" <qt>  "
"<p><b>Duplex Printing:</b> These controls may be grayed out if your printer  "
"does not support <em>duplex printing</em> (i.e. printing on both sides of the "
"sheet).  These controls are active if your printer supports duplex printing.  "
"<p>  You can choose from 3 alternatives: </p> "
"<ul>  "
"<li> <b>None.</b> This prints each page of the job on one side of the sheets "
"only. </li>  "
"<li> <b>Long Side.</b> This prints the job on both sides of the paper sheets.  "
"It prints the job in a way so that the backside has the same orientation as the "
"front  side if you turn the paper over the long edge. (Some printer drivers "
"name this mode  <em>duplex-non-tumbled</em>).  </li>  "
"<li> <b>Short Side.</b> This prints the job on both sides of the paper sheets.  "
"It prints the job so that the backside has the reverse orientation from the "
"front  side if you turn the paper over the long edge, but the same orientation, "
"if you turn it over  the short edge. (Some printer drivers name this mode  <em>"
"duplex-tumbled</em>).  </li>  </ul>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o duplex=...       # examples: \"tumble\" or \"two-sided-short-edge\" "
" </pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Dupleks Druk:</b> Hierdie kontroles mag uitgegrys wees as jou drukker nie "
"<em>dupleks druk</em> ondersteun nie (d.i druk op beide kante van die vel). "
"Hierdie kontroles is aktief as jou drukker dupleks druk ondersteun.  "
"<p>  Jy kan tussen 3 alternatiewes kies: </p> "
"<ul>  "
"<li> <b>Geen.</b> Dit druk elke bladsy van die taak slegs op een kant van die "
"vel. </li>  "
"<li> <b>Lang Kant.</b> Dit druk die taak op beide kante van die papiervelle. "
"Dit druk die taak op so wyse dat die agterkant dieselfde orentasie het as die "
"voorkant wanneer jy die papier oor die lang kant omdraai. (Sommige drukker "
"drywers noem hierdie modus  <em>dupleks-nie-tuimel</em>).  </li>  "
"<li> <b>Kort Kant.</b> Dit druk die taak aan beide kante van die papiervelle.  "
"Dit druk die taak so dat die agterkant die omgekeerde orientasie het van die "
"voorkant as jy die papier omblaai oor die lang kant, maar dieselfde orientasie "
"as jy dit omdraai oor die kort kant. (Sommige drukker drywers noem hierdie "
"modus  <em>dupleks-tuimel</em>).  </li>  </ul>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o dupleks=...       # voorbeelde: \"tuimel\" of "
"\"twee-kantig-kort-rand\"  </pre> </p>  </qt>"

#: kpgeneralpage.cpp:217
msgid ""
" <qt>  "
"<p><b>Banner Page(s):</b> Select banner(s) to print one or two special sheets  "
"of paper just before or after your main job. </p> "
"<p>Banners may contain some pieces of job information, such as user name, time "
"of printing, job title and more. </p> "
"<p>Banner pages are useful to separate different jobs more easily, especially "
"in a multi-user  environment. </p> "
"<p><em><b>Hint:</em></b> You can design your own banner pages. To make use of "
"them, just put the banner  file into the standard CUPS <em>banners</em> "
"directory (This is usually <em>\"/usr/share/cups/banner/\"</em>  "
"Your custom banner(s) must have one of the supported printable formats.  "
"Supported formats are ASCII text, PostScript, PDF and nearly any image format "
"such as PNG, JPEG or  GIF. Your added banner pages will appear in the drop down "
"menu after a restart of CUPS. </p> "
"<p>CUPS comes with a selection of banner pages. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o job-sheets=...       # examples: \"standard\" or \"topsecret\"  "
"</pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Bannier Bladsy(e):</b> Kies bannier(e) om een of twee spesiale velle "
"papier te druk net voor of na jou hoof taak. </p> "
"<p>Banniere kan sommige stukke taak inligting bevat soos gebruikersnaam, tyd "
"van druk, taak titel en meer. </p> "
"<p>Bannier bladsye is nuttig om verskillende take makliker van mekaar te skei, "
"veral in 'n multi-gebruiker omgewing. </p> "
"<p><em><b>Wenk:</em></b> Jy kan jou eie bannier bladsye ontwerp. Om daarvan "
"gebruik te maak, plaas slegs die bannier lêer in die standaard CUPS <em>"
"banniere</em> gids (Dit is gewoontlik <em>\"/usr/deel/cups/bannier/\"</em>  "
"Jou gebruiklike bannier(e) moet een van die ondersteunde drukbare formate hê.  "
"Ondersteunde formate is ASCII teks, Naskrif, PDF en omtrent enige beeld formaat "
"soos PNG, JPEG of GIF. Jou bygevoegde bannier bladsye sal in die aftuimel "
"kieslys verskyn na 'n herbegin van CUPS. </p> "
"<p>CUPS kom met 'n seleksie van bannier bladsye. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdraglyn taak opsie parameter:</em>  "
"<pre>    -o taak-velle=...       # voorbeelde: \"standaard\" of \"hoogsgeheim\" "
" </pre> </p>  </qt>"

#: kpgeneralpage.cpp:239
msgid ""
" <qt>  "
"<p><b>Pages per Sheet:</b>  You can choose to print more than one page onto "
"each sheet of paper.  This is sometimes useful to save paper. </p> "
"<p><b>Note 1:</b> the page images get scaled down accordingly to print 2 or 4 "
"pages per sheet.  The page image does not get scaled if you print 1 page per "
"sheet (the default setting.).  "
"<p><b>Note 2:</b> If you select multiple pages per sheet here, the scaling and "
"re-arranging is done  by your printing system. Be aware, that some printers can "
"by themselves print multiple pages per sheet.  In this case you find the option "
"in the printer driver settings. Be careful: if you enable multiple  pages per "
"sheet in both places, your printout will not look as you intended. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Additional hint for power users:</b> This KDEPrint GUI element "
"matches  with the CUPS commandline job option parameter:</em>  "
"<pre>    -o number-up=...        # examples: \"2\" or \"4\"  </pre> </p>  </qt>"
msgstr ""
" <qt>  "
"<p><b>Bladsye per Vel:</b>  Jy kan kies om meer as een bladsy om 'n vel papier "
"te druk. Dit is somtyds nuttig om papier te spaar. </p> "
"<p><b>Nota 1:</b> die bladsy beelde word ooreenkomstig afgeskaal om2 of 4 "
"bladsye per vel te druk. Die bladsy beeld word nie geskaal as jy 1 bladsy per "
"vel druk nie (die verstek instelling).  "
"<p><b>Nota 2:</b> As jy hier veelvuldige bladsye per vel kies, word die skaling "
"en herrangskikking gedoen deur jou druk stelsel. Wees versigtig dat sommige "
"drukkers by hulself veelvuldige bladsye per vel druk. In hierdie geval vind jy "
"die opsie in die drukker drywer instellings. Wees versigtig:  as jy veelvuldige "
"bladsye per vel aktiveer in beide plekke, sal jou uitdruk nie lyk soos jy dit "
"bedoel het nie. </p> "
"<br>  "
"<hr>  "
"<p><em><b>Addisionele wenk vir krag gebruikers:</b> Hierdie KDEDruk GUI element "
"stem ooreen met die CUPS opdarglyn taak opsie parameter:</em>  "
"<pre>    -o aantal-op=...        # voorbeelde: \"2\" of \"4\"  </pre> </p>  "
"</qt>"

