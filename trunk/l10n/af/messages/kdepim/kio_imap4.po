#: imap4.cc:627
msgid "Message from %1 while processing '%2': %3"
msgstr "Boodskap vanaf %1 terwyl '%2 gesprosesseer word: %3"

#: imap4.cc:629
msgid "Message from %1: %2"
msgstr "Boodskap vanaf %1: %2"

#: imap4.cc:950
msgid ""
"The following folder will be created on the server: %1 What do you want to "
"store in this folder?"
msgstr ""
"Die volgende gids sal op die bediener geskep word: %1 Wat wil jy in hierdie "
"gids stoor"

#: imap4.cc:952
msgid "Create Folder"
msgstr "Skep Gids"

#: imap4.cc:953
msgid "&Messages"
msgstr "Boodskappe"

#: imap4.cc:953
msgid "&Subfolders"
msgstr "Subgidse"

#: imap4.cc:1285
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr ""
"Afteken ('unsubscribe') van gids %1 was onsuksesvol. Die bediener het %2 "
"geantwoord"

#: imap4.cc:1306
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr ""
"Intekening van gids %1 was onsuksesvol.  Die bediener het %2 geantwoord"

#: imap4.cc:1356 imap4.cc:1368
msgid "Changing the flags of message %1 failed."
msgstr "Verandering van die vlaggies van boodskap %1 was onsuksesvol."

#: imap4.cc:1408
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Opstel van die Toegangsbeheerlys van gids %1 vir gebruiker %2 was onsuksesvol. "
"Die bediener het %3 geantwoord"

#: imap4.cc:1427
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Uitwissing van die Toegangsbeheerlys van gids %1 vir gebruiker %2 was "
"onsuksesvol. Die bediener het %3 geantwoord"

#: imap4.cc:1444 imap4.cc:1471
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: %2"
msgstr ""
"Die herroep van die Toegangsbeheerlys vir gids %1 was onsuksesvol. Die bediener "
"het %2 geantwoord"

#: imap4.cc:1505
msgid "Searching of folder %1 failed. The server returned: %2"
msgstr "Die soektog na gids %1 was onsuksesvol. Die bediener het %2 geantwoord"

#: imap4.cc:1543
msgid "Setting the annotation %1 on folder %2  failed. The server returned: %3"
msgstr ""
"Opstel van annotasie %1 van gids %2 was onsuksesvol. Die bediener het %3 "
"geantwoord"

#: imap4.cc:1567
msgid ""
"Retrieving the annotation %1 on folder %2 failed. The server returned: %3"
msgstr ""
"Die herroep van annotasie %1 van gids %2 was onsuksesvol. Die bediener het %3 "
"geantwoord"

#: imap4.cc:1616
msgid "Unable to close mailbox."
msgstr "Nie moontlik om posbus toe te maak nie."

#: imap4.cc:1884
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Die bediener %1 ondersteun nie Imap4 of Imap4rev1 nie.\n"
"Dit het homself met met: %2 geïdentifiseer"

#: imap4.cc:1895
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Die bediener ondersteun nie Tls nie.\n"
"Deaktiveer hierdie sekuriteitfunksie om ongekodeer te konnekteer."

#: imap4.cc:1920
msgid "Starting TLS failed."
msgstr "Begin van Tls was onsuksesvol."

#: imap4.cc:1930
msgid "The authentication method %1 is not supported by the server."
msgstr ""
"Die geldigheidsverklaring metode %1 word nie deur die bediener ondersteun nie."

#: imap4.cc:1945
msgid "Username and password for your IMAP account:"
msgstr "Gebruikernaam en wagwoord vir jou IMAP rekening:"

#: imap4.cc:1959
#, fuzzy
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server %1 replied:\n"
"%2"
msgstr ""
"Nie moontlik om aan te teken nie. Waarskynlik die verkeerde wagwoord.\n"
"Bediener %1 het %2 geantwoord:\n"
"%2"

#: imap4.cc:1966
msgid ""
"Unable to authenticate via %1.\n"
"The server %2 replied:\n"
"%3"
msgstr ""
"Nie moontlik om geldigheidstoets te doen d.m.v. %1 nie.\n"
"Bediener %2 het geantwoord:\n"
"%3"

#: imap4.cc:1973
msgid "SASL authentication is not compiled into kio_imap4."
msgstr "SASL geldigheidsverklaring word nie binne kio_imap4 saamgestel nie"

#: imap4.cc:2502
msgid "Unable to open folder %1. The server replied: %2"
msgstr ""
"Nie moontlik om gids %1 oop te maak nie. Die bediener het %2 geantwoord"

