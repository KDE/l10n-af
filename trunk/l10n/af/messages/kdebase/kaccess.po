msgstr "Wil jy werklik \"%1\", \"%2\" en \"%3\" deaktiveer?"

#: kaccess.cpp:695
msgid "Do you really want to deactivate \"%1\", \"%2\", \"%3\" and \"%4\"?"
msgstr "Wil jy werklik \"%1\", \"%2\", \"%3\" en \"%4\" deaktiveer?"

#: kaccess.cpp:702
msgid "Do you really want to activate \"%1\"?"
msgstr "Wil jy werklik \"%1\" aktiveer?"

#: kaccess.cpp:705
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\"?"
msgstr "Wil jy werklik \"%1\" en deaktiveer \"%2\" aktiveer?"

#: kaccess.cpp:708
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\" and \"%3\"?"
msgstr "Wil jy werklik \"%1\" en deaktiveer \"%2\" en \"%3\" aktiveer?"

#: kaccess.cpp:712
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\", \"%3\" and \"%4\"?"
msgstr "Wil jy werklik \"%1\" en deaktiveer \"%2\", \"%3\" en \"%4\" aktiveer?"

#: kaccess.cpp:719
msgid "Do you really want to activate \"%1\" and \"%2\"?"
msgstr "Wil jy werklik \"%1\" en \"%2\" aktiveer?"

#: kaccess.cpp:722
msgid "Do you really want to activate \"%1\" and \"%2\" and to deactivate \"%3\"?"
msgstr "Wil jy werklik \"%1\" en \"%2\" en deaktiveer \"%3\" aktiveer?"

#: kaccess.cpp:726
msgid "Do you really want to activate \"%1\", and \"%2\" and to deactivate \"%3\" and \"%4\"?"
