#: medianotifier.cpp:167
msgid ""
"An autorun file has been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"'n Autohardloop lêer was gevind op jou '%1'. Wil jy dit uitvoer?\n"
"Let daarop dat die uitvoering van 'n lêer op 'n medium die stelsel sekuriteit "
"kan verydel"

#: medianotifier.cpp:171
#, c-format
msgid "Autorun - %1"
msgstr "Autohardloop - %1"

#: medianotifier.cpp:241
msgid ""
"An autoopen file has been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"'n Auto open lêer was gevind op jou '%1'. Wil jy '%2' oopmaak ?\n"
"Let daarop dat die opening van 'n lêer op 'n medium die stelsel sekuriteit kan "
"verydel"

#: medianotifier.cpp:245
#, c-format
msgid "Autoopen - %1"
msgstr "Auto open - %1"

