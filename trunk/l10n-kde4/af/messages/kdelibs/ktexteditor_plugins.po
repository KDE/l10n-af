#: wordcompletion/docwordcompletion.cpp:244
msgid "Pop Up Completion List"
msgstr "Spring Voltooiïng Lys"

#: wordcompletion/docwordcompletion.cpp:248
msgid "Automatic Completion Popup"
msgstr "Laat Voltooiïng Lys Outomaties Opspring"

#: wordcompletion/docwordcompletion.cpp:255
msgid "Shell Completion"
msgstr "Tolk Voltooiïng"

#: wordcompletion/docwordcompletion.cpp:262
