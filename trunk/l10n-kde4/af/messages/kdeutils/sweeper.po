#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my gesondheid of mediese informasie "
"gebruik:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Demografie/Bevolkingsstatistiek"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my nie-persoonlike "
"idetifiseerbareinformasie gebruik:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Om te besluit oor my belangstellings, gewoontes of algemene gedrag"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
