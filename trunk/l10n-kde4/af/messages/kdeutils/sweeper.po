#: rc.cpp:27 rc.cpp:39
msgid "For marketing or advertising purposes"
msgstr "Vir bemarking of advertensie-doeleindens."

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:30 rc.cpp:42 rc.cpp:54
msgid "To share with other companies"
msgstr "Om te deel met ander maatskappye"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:33
msgid "Health Information"
msgstr "Gesondheid-informasie"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my gesondheid of mediese informasie "
"gebruik:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Demografie/Bevolkingsstatistiek"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my nie-persoonlike "
"idetifiseerbareinformasie gebruik:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "Om te besluit oor my belangstellings, gewoontes of algemene gedrag"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my persoonlike informasie met "
"andermaatskappye deel"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Waarsku my as ek ´n ruimte besoek wat my nie laat weet watter informasie "
"hullevan my het nie"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "Persoonlike Inligting"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Waarsku my as ek ´n webplek besoek wat kontak kan maak met my oor "
"anderprodukte en dienste:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Waarsku my as ek ´n webplek besoek wat my persoonlike inligting gebruik na:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "Om te besluit oor my gewoontes, belangstellings en algemene gedrag"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "Deur telefoon"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "Deur pos"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "Deur e-pos"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "En moenie my toelaat om my kontak informasie te verwyder nie"

