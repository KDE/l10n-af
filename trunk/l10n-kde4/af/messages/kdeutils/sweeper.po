msgstr "Deur pos"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "Deur e-pos"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "En moenie my toelaat om my kontak informasie te verwyder nie"

