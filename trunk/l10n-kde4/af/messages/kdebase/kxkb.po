#: kxkb.cpp:384
msgid "A utility to switch keyboard maps"
msgstr "'n Nutsprogram op sleutelbord uitlegte te wysig."

#: kxkb.cpp:388
msgid "KDE Keyboard Tool"
msgstr "Kde Sleutelbord Program"

