msgstr ""
"Die hoeveelheid tyd, waarna die skerm spaarder begin is, om te vra vir die "
"ontsluit wagwoord. "

#: scrnsave.cpp:225
#, fuzzy
msgid " sec"
msgstr "1 sekonde"

#: scrnsave.cpp:243
