#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Voer uit - Maak oop afgeleë lêers, hou dop veranderinge, vra vir oplaai"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Behandel URLs as lokale lêers en verwyder hulle agterna"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr ""

#: main.cpp:52
msgid "Command to execute"
msgstr "Opdrag om uit te voer"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "Url(s) of plaaslike lêer gebruik vir 'opdrag'"

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "'opdrag' verwag.\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Die Url %1\n"
"is misformde"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Verwyder afgeleë URL %1\n"
"nie toegelaat met --tydelike lêer skakel"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Die veronderstel tydelike lêer\n"
"%1\n"
"is veranderd.\n"
"Wil jy nogsteeds dit verwyder?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "Lêer het verander"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "Moenie verwyder nie"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Die lêer\n"
"%1\n"
"het al veranderde.\n"
"Doen jy wil hê na oplaai Die verander?"

#: main.cpp:230
msgid "Upload"
msgstr "Oplaai"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "Moenie Oplaai nie"

