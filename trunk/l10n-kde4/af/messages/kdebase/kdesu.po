#: kdesu.cpp:85
msgid "KDE su"
msgstr "Kde su"

#: kdesu.cpp:86
msgid "Runs a program with elevated privileges."
msgstr "Loop 'n program met verhoogde voorregte."

#: kdesu.cpp:88
