#: xml_doc.cpp:4462
msgid "T(value)"
msgstr "T(waarde)"

#. i18n: file: functions/text.xml:116
#: xml_doc.cpp:4464
msgid "T(\"KOffice\") returns \"KOffice\""
msgstr "T(\"Koffice\") gee terug \"Koffice\""

#. i18n: file: functions/text.xml:117
#: xml_doc.cpp:4466
